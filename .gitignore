# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.python-version

# --- Virtual environments ---------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Secrets and local configuration ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.*
.npmrc
.pypirc

# --- Database files (local development) ---------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- User uploads (keep the folder, ignore its contents) ----------------------
/upload/*
!/upload/.gitkeep

# --- Tests, coverage and tool caches ------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.cache/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Logs and temporary files -------------------------------------------------
*.log
logs/
tmp/
*.tmp
*.bak
*.swp

# --- Editors and IDEs ---------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Operating system files ---------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
