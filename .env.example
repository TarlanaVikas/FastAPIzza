# Copy to .env and adjust. The real .env is git-ignored; never commit secrets.

# --- Database -------------------------------------------------------------
# Leave empty to use a local SQLite file (fastapizza.db) in the project folder.
# For PostgreSQL:
#   DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/fastapizza
DATABASE_URL=sqlite:///./fastapizza.db

# --- Authentication -------------------------------------------------------
# Required for any real deployment: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a temporary key is generated at startup and sessions end on restart.
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- Uploads --------------------------------------------------------------
# Where avatars and pizza photos are stored (default: ./upload) and the size limit.
UPLOAD_DIR=./upload
MAX_UPLOAD_MB=5

# --- Optional MongoDB compatibility -----------------------------------------
# MONGO_CONN=mongodb://127.0.0.1:27017/fastapizza

# --- Staff account (read by `python -m scripts.create_admin`) --------------
ADMIN_USERNAME=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
